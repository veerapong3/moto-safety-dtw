# Google Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Spreadsheet: Users / Registrations / Settings
GOOGLE_SHEET_ID=your_spreadsheet_id

# Fallback Drive root folder (MOTO-Safety). Can also set in Settings sheet.
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_drive_folder_id

# Drive OAuth ของบัญชีเจ้าของโฟลเดอร์
# สร้าง OAuth Desktop client → รัน: npm run oauth:drive
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=

# Vercel Blob — fallback เมื่อยังไม่มี Drive OAuth
BLOB_READ_WRITE_TOKEN=

# JWT secret for session cookies
AUTH_SECRET=replace_with_long_random_secret

# Optional seed defaults
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_NAME=ผู้ดูแลระบบ
